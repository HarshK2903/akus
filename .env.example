# Docker LOCAL / DEMO. Copy to .env only when changing defaults. Never commit .env.
AKUS_ENV=local
AKUS_DEMO_ENABLED=true
AKUS_DATABASE_URL=postgresql+psycopg://akus_demo:akus_demo@db:5432/akus
AKUS_PUBLIC_ORIGIN=http://127.0.0.1:8080
AKUS_INSTITUTION_LABEL=Local demonstration institution
# Institutional testing: use a separate approved database, disable demo access,
# and fill ALL four fields privately. Blank fields keep Google CONFIGURATION REQUIRED.
AKUS_GOOGLE_CLIENT_ID=
AKUS_GOOGLE_CLIENT_SECRET=
AKUS_GOOGLE_REDIRECT_URI=
AKUS_SESSION_KEY=
# Exact local callback: http://127.0.0.1:8080/api/v1/auth/google/callback
# Session key: a newly generated Fernet key. See docs/GOOGLE_OIDC_SETUP.md.
# Production requires HTTPS, demo disabled, complete OIDC settings and private DB
# credentials. This development Compose file is not a production deployment plan.
